---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import SiteStrip from '../components/SiteStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import FourUp from '../components/FourUp.astro';
import Compare from '../components/Compare.astro';
import Download from '../components/Download.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { release } from '../data/release';

const title = 'Aihub — 把多家 AI 的网页端放进一个窗口';
const description =
  `把 DeepSeek、ChatGPT、Claude 等多家 AI 的网页端放进一个窗口。标签在顶部，分屏最多四格，Windows 上每站点独立登录态，安装包 ${release.windows.size}，不自带模型也不代理请求。`;
---

<Base title={title} description={description} path="/">
  <Nav />
  <main>
    <Hero />
    <Stats />
    <SiteStrip />
    <HowItWorks />
    <Features />
    <FourUp />
    <Compare />
    <Download />
  </main>
  <SiteFooter />
</Base>
